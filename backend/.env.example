# NeuroPulseAI Backend Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

APP_NAME="NeuroPulseAI Backend"
ENVIRONMENT="development"
DEBUG=true

# Database: SQLite default for local development, or PostgreSQL URL
DATABASE_URL="sqlite:///./neuropulse.db"
# Example PostgreSQL: DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/neuropulse"

# JWT Secret Key - Change this in production
JWT_SECRET_KEY="neuropulse-dev-secret-key-change-in-production-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Bind Configuration
HOST="0.0.0.0"
PORT=8000
